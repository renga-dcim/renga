# Where the agent asks for its home deployment: a Renga deployment, which
# answers with itself, or a resolver. Required; no default. Replace this
# placeholder.
renga_url = "https://renga.example.invalid"

# SECURITY: Keep false in production. Setting true permits plaintext HTTP, which
# exposes the bearer token and inventory to network interception. Use only for
# deliberate local development against a trusted loopback service.
allow_insecure_http = false

# Organization intake API key. Required; no default. This placeholder is not a secret.
intake_api_key = "replace-with-organization-intake-api-key"

# Optional intervals and transport policy, all expressed in seconds.
# Omitted values use the defaults shown below; every value must be greater than zero.
inventory_interval_seconds = 3600
# Maximum 60: the server lease is 90 seconds, reserving a 25-second delivery budget.
checkin_interval_seconds = 60
config_refresh_interval_seconds = 300
request_timeout_seconds = 20
max_retry_attempts = 5

# Optional labels sent with every observation. Renga's triage rules can match
# them, for example to set the owning team. At most 32 labels; keys are 1-63
# letters, digits, ".", "_", "-", or "/", starting and ending with a letter or
# digit; values are at most 255 characters. Labels describe how you run the
# host and are not collected from it.
# [labels]
# team = "storage"
# environment = "production"

# Optional job policy: which compiled-in capabilities Renga may ask this agent
# to run on demand. Without this table, every "observe" capability (one that
# only reads the host) is enabled. An explicit list, even an empty one, enables
# exactly what it names: a capability name enables every version, a
# "name@version" key enables one. Capabilities that change the host are never
# enabled by default, and Renga cannot enable them remotely.
# [jobs]
# enabled = ["inventory.collect"]

# Optional local Prometheus exporters to read power from, when the host's own
# hwmon sensors are missing or incomplete. Only a fixed mapping is read: hwmon
# power from node_exporter, and the DCMI reading plus power supply sensors from
# ipmi_exporter. Endpoints must resolve to loopback unless allow_remote = true,
# redirects and proxies are never used, and the intake key is never sent. A
# remote endpoint may read a bearer token from bearer_token_file. At most 16;
# interval 10-3600 seconds (default 60), timeout 1-30 (default 10).
# [[exporters]]
# url = "http://127.0.0.1:9100/metrics" # node_exporter
#
# [[exporters]]
# url = "http://127.0.0.1:9290/metrics" # ipmi_exporter
