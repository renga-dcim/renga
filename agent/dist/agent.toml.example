# Renga server base URL. Required; no default. Replace this placeholder.
renga_url = "https://renga.example.invalid"

# Source bearer token. Required; no default. This placeholder is not a secret.
token = "replace-with-source-token"

# Stable identity for this installation. Required; no default. Generate once with
# `uuidgen`, store it here, and preserve it across upgrades.
installation_id = "00000000-0000-4000-8000-000000000000"

# Optional intervals and transport policy, all expressed in seconds.
# Omitted values use the defaults shown below; every value must be greater than zero.
inventory_interval_seconds = 3600
checkin_interval_seconds = 60
config_refresh_interval_seconds = 300
request_timeout_seconds = 30
max_retry_attempts = 5
