# Renga server base URL. Required; no default. Replace this placeholder.
renga_url = "https://renga.example.invalid"

# SECURITY: Keep false in production. Setting true permits plaintext HTTP, which
# exposes the bearer token and inventory to network interception. Use only for
# deliberate local development against a trusted loopback service.
allow_insecure_http = false

# Organization intake API key. Required; no default. This placeholder is not a secret.
intake_api_key = "replace-with-organization-intake-api-key"

# Optional intervals and transport policy, all expressed in seconds.
# Omitted values use the defaults shown below; every value must be greater than zero.
inventory_interval_seconds = 3600
# Maximum 60: the server lease is 90 seconds, reserving a 25-second delivery budget.
checkin_interval_seconds = 60
config_refresh_interval_seconds = 300
request_timeout_seconds = 20
max_retry_attempts = 5

# Optional labels sent with every observation. Renga's triage rules can match
# them, for example to set the owning team. At most 32 labels; keys are 1-63
# letters, digits, ".", "_", "-", or "/", starting and ending with a letter or
# digit; values are at most 255 characters. Labels describe how you run the
# host and are not collected from it.
# [labels]
# team = "storage"
# environment = "production"
