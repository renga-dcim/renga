#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
service_name="renga-agent"
service_unit="amp-svc-${service_name}.service"
agent_command="exec '$repo_root/target/debug/renga-agent' --config '$repo_root/dev/renga-agent/agent.toml' --state-directory '$repo_root/dev/renga-agent/state'"

if amp orb service list | grep -q "^${service_unit}[[:space:]]"; then
  amp orb service restart "$service_name" >/dev/null
else
  amp orb service start "$service_name" --cwd "$repo_root" --command "$agent_command" >/dev/null
fi
